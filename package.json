{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-device",
  "version": "0.1.2",
  "description": "Local Android emulator viewing and session-bound automation for OpenCode Desktop on Windows, Linux, and macOS",
  "keywords": [
    "android",
    "desktop",
    "emulator",
    "opencode",
    "opencode-plugin"
  ],
  "homepage": "https://github.com/viralcodex/opencode-demul#readme",
  "bugs": {
    "url": "https://github.com/viralcodex/opencode-demul/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viralcodex/opencode-demul.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./gui-experimental": "./dist/gui.cjs"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings src script vite.config.ts",
    "fmt": "oxfmt --write --ignore-path .oxfmtignore .",
    "fmt:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "bundle": "node node_modules/vite/bin/vite.js build --configLoader runner && bun build src/index.ts --target=node --format=esm --packages=external --outfile=dist/server.js",
    "typecheck": "tsc6 --noEmit -p tsconfig.test.json",
    "typecheck:tsc": "bun run typecheck",
    "test": "bun test",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun test",
    "verify:package": "node script/verify-package.mjs",
    "helpers:lock": "node script/update-helper-lock.mjs",
    "verify:helpers": "node script/verify-helpers.mjs",
    "release:check": "bun run check && bun run bundle && bun run verify:package"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.2",
    "@opencode/schema": "2.2.2",
    "effect": "4.0.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@types/node": "24.12.2",
    "@types/ws": "8.18.2",
    "electron": "44.9.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "solid-js": "1.9.17",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "bun@1.3.6"
}
